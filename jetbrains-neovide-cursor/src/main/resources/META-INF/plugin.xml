<idea-plugin url="https://github.com/BowlofThinSoup/Lune-Glide">
  <id>dev.lune.neovide-cursor</id>
  <name>Lune Glide</name>
  <version>0.1.3</version>
  <vendor url="https://github.com/BowlofThinSoup">lune</vendor>
  <description><![CDATA[
    Neovide-style four-corner spring cursor animation for IntelliJ IDEA.
    Supports multiple carets, configurable stretch and motion duration, and native cursor restoration at rest.
    Configure under Settings → Editor → Lune Glide.
    原生 JetBrains 光标动画插件，支持四角弹簧拖尾、多光标和一键关闭，无需修改 IDE 安装文件。
  ]]></description>
  <idea-version since-build="262" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="dev.lune.cursor.CursorSettings"/>
    <applicationService serviceImplementation="dev.lune.cursor.CursorService"/>
    <editorFactoryListener implementation="dev.lune.cursor.EditorLifecycle"/>
    <applicationConfigurable parentId="editor" id="dev.lune.neovide-cursor.settings"
      displayName="Lune Glide" instance="dev.lune.cursor.CursorConfigurable"/>
  </extensions>
  <applicationListeners>
    <listener class="dev.lune.cursor.PluginLifecycle" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="dev.lune.cursor.PluginLifecycle" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
  </applicationListeners>
  <actions>
    <action id="NeovideCursor.Toggle" class="dev.lune.cursor.ToggleCursorAction"
      text="Lune Glide: Toggle Animation" description="Enable or disable Lune Glide cursor animation">
      <add-to-group group-id="ViewMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
